# Ed25519 access tokens (required). Generate with:
#   ./deploy/k8s/scripts/generate-jwt-ed25519.sh >> .env
# Values may use literal \n for PEM newlines in a single-line .env entry.
JWT_ED25519_PRIVATE_KEY=
JWT_ED25519_PUBLIC_KEYS=
JWT_ACTIVE_KEY_ID=
JWT_ISSUER=https://api.veritasvpn.cloud
JWT_AUDIENCE=veritasvpn-api
AGENT_AUTH_TOKEN=change-me-generate-with-openssl-rand-hex-24
DB_PASSWORD=change-me-generate-with-openssl-rand-hex-16
REDIS_PASSWORD=change-me-generate-with-openssl-rand-hex-24
NATS_PASSWORD=change-me-generate-with-openssl-rand-hex-24
PUBLIC_IP=change-me-or-set-to-your-vps-ip
SERVER_HOSTNAME=linuxdesktop
SERVER_REGION=sa
SERVER_CITY=local
SERVER_COUNTRY=AR
MANAGER_ENDPOINT=http://127.0.0.1:8082

# Leave BTCPAY_API_KEY empty and set ALLOW_MOCK_BTCPAY=true for local mock checkout.
# Public hosts must omit ALLOW_MOCK_BTCPAY (or set false) and configure real BTCPAY_*.
# Production (ENVIRONMENT=production) requires real BTCPAY_* including WEBHOOK_SECRET;
# mock routes are disabled and unsigned webhooks are rejected.
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → Configure → token).
# Required for veritasvpn.cloud public access. Do not commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_PUBLIC_URL=https://btcpay-mainnet.veritasvpn.cloud

# Legacy unpaid-tier region restriction (no longer grants VPN access).
FREE_ALLOWED_REGIONS=
PREMIUM_PRICE_USD_CENTS=300
PREMIUM_PERIOD_DAYS=30
CHECKOUT_SUCCESS_URL=https://veritasvpn.cloud/account/#/subscription
CHECKOUT_CANCEL_URL=https://veritasvpn.cloud/account/#/subscription
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BILLING_PUBLIC_URL=http://localhost:8083

# Resend API key for password reset emails (https://resend.com)
RESEND_API_KEY=
PUBLIC_BASE_URL=https://veritasvpn.cloud
