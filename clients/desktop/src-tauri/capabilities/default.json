{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main", "billing-checkout"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "opener:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://veritasvpn.cloud/**" },
        { "url": "https://api.veritasvpn.cloud/**" }
      ]
    },
    {
      "identifier": "http:allow-fetch-send",
      "allow": [
        { "url": "https://veritasvpn.cloud/**" },
        { "url": "https://api.veritasvpn.cloud/**" }
      ]
    },
    {
      "identifier": "http:allow-fetch-read-body",
      "allow": [
        { "url": "https://veritasvpn.cloud/**" },
        { "url": "https://api.veritasvpn.cloud/**" }
      ]
    },
    {
      "identifier": "http:allow-fetch-cancel",
      "allow": [
        { "url": "https://veritasvpn.cloud/**" },
        { "url": "https://api.veritasvpn.cloud/**" }
      ]
    },
    {
      "identifier": "http:allow-fetch-cancel-body",
      "allow": [
        { "url": "https://veritasvpn.cloud/**" },
        { "url": "https://api.veritasvpn.cloud/**" }
      ]
    }
  ]
}
