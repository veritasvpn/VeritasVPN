# BTCPay environment — production mainnet defaults
# To switch to mainnet: set BTC_NETWORK=mainnet BTC_RPC_PORT=8332 BTC_P2P_PORT=8333
# Copy to .env and fill in secure passwords

BTC_NETWORK=mainnet
BTC_RPC_PORT=8332
BTC_P2P_PORT=8333
BTC_RPC_PASSWORD=generate_a_strong_random_password_here
BTCPAY_POSTGRES_PASSWORD=generate_a_strong_password_here
BTCPAY_EXTERNAL_URL=http://localhost:49392
