# Copy to /etc/veritasvpn/egress.env on the production host and chmod 600.
# Root-owned and not group/world writable: verify-vpn-egress.sh refuses
# other modes when it runs as root.
#
# VERITAS_PUBLIC_IP is the VPN NAT egress address (the same value as the
# GitHub Actions repository variable). Do not use a Cloudflare CDN A record.
VERITAS_PUBLIC_IP=

# Optional. Default is the lowest-metric IPv4 default route. Set this when
# Tailscale or another interface could win that selection.
# EGRESS_IFACE=enp1s0
