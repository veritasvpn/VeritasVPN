  "panels": [
    {
      "type": "text", "title": "Privacy boundary", "id": 1,
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "markdown", "content": "### VeritasVPN private operational analytics\nAggregate infrastructure, VPN capacity, account, and payment measurements only. **No browsing history, DNS requests, destination domains, client IP addresses, account IDs, email addresses, or WireGuard public keys are collected here.**"}
    },
    {
      "type": "stat", "title": "Connected now", "id": 2,
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "veritas_agent_active_peer_count", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Configured peers", "id": 3,
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "veritas_agent_peer_count", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Total accounts", "id": 4,
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 3},
      "datasource": {"type": "postgres", "uid": "postgres"},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT count(*)::double precision AS value FROM accounts", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^value$/", "values": false}}
    },
    {
      "type": "stat", "title": "Premium active", "id": 5,
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 3},
      "datasource": {"type": "postgres", "uid": "postgres"},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT count(*)::double precision AS value FROM subscriptions WHERE tier='premium' AND status='active' AND current_period_end > NOW()", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^value$/", "values": false}}
    },
