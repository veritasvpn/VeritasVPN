      "type": "stat", "title": "Anonymous accounts", "id": 12,
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 17},
      "datasource": {"type": "postgres", "uid": "postgres"},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT count(*)::double precision AS value FROM accounts WHERE email IS NULL", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^value$/", "values": false}}
