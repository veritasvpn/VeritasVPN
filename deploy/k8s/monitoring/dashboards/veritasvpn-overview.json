      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(veritas_agent_rx_bytes_total[5m]) * 8", "legendFormat": "Received", "refId": "A"},
