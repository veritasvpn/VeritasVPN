      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT $__timeGroupAlias(created_at,'1h'), count(*)::double precision AS value FROM accounts WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"]}, "tooltip": {"mode": "single"}}
