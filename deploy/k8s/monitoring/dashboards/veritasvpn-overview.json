      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "avg_over_time(probe_success{instance=\"https://veritasvpn.cloud/\"}[$__range]) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 99}, {"color": "green", "value": 99.9}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "API uptime", "id": 7,
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "avg_over_time(probe_success{instance=\"https://api.veritasvpn.cloud/healthz\"}[$__range]) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 99}, {"color": "green", "value": 99.9}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
