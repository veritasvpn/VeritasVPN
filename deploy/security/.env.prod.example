# Production environment variables template
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Generate secrets:
#   ./deploy/k8s/scripts/generate-jwt-ed25519.sh >> .env
#   openssl rand -hex 24  # AGENT_AUTH_TOKEN
#   openssl rand -hex 16  # DB_PASSWORD, REDIS_PASSWORD

JWT_ED25519_PRIVATE_KEY=
JWT_ED25519_PUBLIC_KEYS=
JWT_ACTIVE_KEY_ID=
JWT_ISSUER=https://api.veritasvpn.cloud
JWT_AUDIENCE=veritasvpn-api
AGENT_AUTH_TOKEN=
DB_PASSWORD=
REDIS_PASSWORD=

PUBLIC_IP=
SERVER_HOSTNAME=veritas-node
SERVER_REGION=sa
SERVER_CITY=asunción
SERVER_COUNTRY=PY

MANAGER_ENDPOINT=http://127.0.0.1:8082

CLOUDFLARE_TUNNEL_TOKEN=

BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_PUBLIC_URL=https://btcpay.veritasvpn.cloud
BTCPAY_SERVER_URL=http://host.docker.internal:49392

FREE_ALLOWED_REGIONS=
PREMIUM_PRICE_USD_CENTS=300
PREMIUM_PERIOD_DAYS=30

CHECKOUT_SUCCESS_URL=https://veritasvpn.cloud/billing/success.html
CHECKOUT_CANCEL_URL=https://veritasvpn.cloud/billing/cancel.html
CORS_ORIGINS=https://veritasvpn.cloud,https://www.veritasvpn.cloud
BILLING_PUBLIC_URL=https://veritasvpn.cloud

ALLOW_MOCK_BTCPAY=false
