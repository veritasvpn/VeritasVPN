[Unit]
Description=Delete JWT_SECRET from veritas-secrets after cutover drain window
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=KUBECONFIG=/home/jpg/.kube/config
Environment=JWT_CUTOVER_AT_FILE=/etc/veritasvpn/jwt-cutover-at
ExecStart=/home/jpg/VeritasVPN/deploy/k8s/scripts/delete-jwt-secret-after.sh
StandardOutput=journal
StandardError=journal
