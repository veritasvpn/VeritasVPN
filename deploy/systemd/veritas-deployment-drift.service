[Unit]
Description=Audit VeritasVPN source and Kubernetes deployment drift
After=k3s.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Repo is owned by jpg; running as root trips git safe.directory ("dubious
# ownership") on every timer tick and previously masked that as a clean tree.
User=jpg
Group=jpg
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
WorkingDirectory=/opt/veritasvpn
ExecStart=/opt/veritasvpn/deploy/verify/deployment-drift.sh
