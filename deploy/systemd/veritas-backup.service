[Unit]
Description=Encrypted VeritasVPN Kubernetes backup
After=k3s.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/veritasvpn/r2-backup.env
Environment=R2_UPLOAD_REQUIRED=true
Environment=R2_RETENTION_DAYS=60
ExecStart=/opt/veritasvpn/deploy/backup/backup-k3s.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
