[Unit]
Description=VeritasVPN WireGuard tunnel hold (5+ min, no-flap)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/veritasvpn/e2e.env
WorkingDirectory=/opt/veritasvpn
ExecStart=/opt/veritasvpn/deploy/verify/tunnel-hold-e2e.sh
# Failures land in the journal; Alertmanager covers cluster, not this host oneshot.
StandardOutput=journal
StandardError=journal
