<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the split-tunnel picker enumerate launchable apps without requesting broad package access. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".VeritasVpnApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:restoreAnyVersion="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="VeritasVPN"
        android:supportsRtl="true"
        android:theme="@style/Theme.VeritasVPN">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VeritasVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The billing service uses this verified App Link as BTCPay's
                 post-payment destination. It has no sensitive query data. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="veritasvpn.cloud"
                    android:path="/billing/app-return" />
            </intent-filter>
            <!-- A completed BTCPay checkout returns through this exact custom
                 scheme. No account, token, or invoice data is accepted here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="veritasvpn"
                    android:host="billing"
                    android:path="/success" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.VeritasVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the active WireGuard VPN tunnel and shows connection status notifications." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>
