<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity">
            <!-- The billing service uses this verified App Link as BTCPay's
                 post-payment destination. It has no sensitive query data.
                 The Play flavor does not merge this filter. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="veritasvpn.cloud"
                    android:path="/billing/app-return" />
            </intent-filter>
            <!-- A completed BTCPay checkout returns through this exact custom
                 scheme. No account, token, or invoice data is accepted here.
                 The Play flavor does not merge this filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="veritasvpn"
                    android:host="billing"
                    android:path="/success" />
            </intent-filter>
        </activity>
    </application>
</manifest>
